DATABASE_URL=postgresql://postgres:postgres@localhost:5440/lostfound
PORT=4000
# Staff-only item photos are stored here (relative to backend/).
UPLOAD_DIR=uploads

# Optional AI assist (pre-filling form fields + clarity questions). Leave empty to use the rule-based fallback.
GEMINI_API_KEY=
# Read from env, never hard-coded. Used only for extraction + clarity questions – never for deciding matches.
GEMINI_EXTRACTION_MODEL=gemini-3.6-flash
# NOT used in v1 – see README "Future improvements".
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
